# ---------------------------------------------------------------- Unity
# Dossiers régénérés par l'éditeur. Library/ notamment pèse plusieurs Go et se
# reconstruit intégralement à la première ouverture du projet.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]rtifacts/

# Tampon de build : ecrit par BuildTools a chaque compilation, il decrit l'artefact et non
# la source. Le versionner rendrait le depot modifie apres chaque build.
/[Aa]ssets/[Rr]esources/build_sha.txt
/[Aa]ssets/[Rr]esources/build_sha.txt.meta

# Deposes par le package Performance Testing a chaque lancement en batchmode. Ils decrivent
# une execution, pas le jeu. Non ignores, ils salissent l'arbre a chaque build -- et un arbre
# sale fait porter au tampon un suffixe + qui dit au joueur que sa version ne correspond a
# aucun commit.
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json.meta

# Artefact Burst depose a la racine par le build WebGL, hors de tout dossier de build.
/Data/

# Caches d'outils Unity
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.consulo/

# Assets importés dont Unity régénère le .meta
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# ---------------------------------------------------------------- IDE
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.DotSettings.user

# ---------------------------------------------------------------- Système
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- Divers
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---------------------------------------------------------------- Attention
# Ne JAMAIS ignorer les .meta : Unity y stocke le GUID de chaque asset. Un .meta
# manquant fait perdre toutes les références qui pointaient vers l'asset (scripts
# détachés de leurs GameObjects, sprites vidés). Aucune règle *.meta ici.
