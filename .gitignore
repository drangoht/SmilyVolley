# ---------------------------------------------------------------- Unity
# Dossiers régénérés par l'éditeur. Library/ notamment pèse plusieurs Go et se
# reconstruit intégralement à la première ouverture du projet.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]rtifacts/

# Caches d'outils Unity
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
.consulo/

# Assets importés dont Unity régénère le .meta
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# ---------------------------------------------------------------- IDE
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
